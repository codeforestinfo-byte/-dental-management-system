<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bill-report" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <parameter name="CLINIC_NAME" class="java.lang.String"/>
    <parameter name="CLINIC_ADDRESS" class="java.lang.String"/>
    <parameter name="BILL_NUMBER" class="java.lang.String"/>
    <parameter name="PATIENT_NAME" class="java.lang.String"/>
    <parameter name="DENTIST_NAME" class="java.lang.String"/>
    <parameter name="TREATMENT_NAME" class="java.lang.String"/>
    <parameter name="CONSULTATION_FEE" class="java.math.BigDecimal"/>
    <parameter name="TREATMENT_FEE" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="AMOUNT_PAID" class="java.math.BigDecimal"/>
    <parameter name="BALANCE" class="java.math.BigDecimal"/>
    <parameter name="BILL_DATE" class="java.lang.String"/>

    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="22" isBold="true"/>
                </textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CLINIC_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="55" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CLINIC_ADDRESS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="120">
            <staticText>
                <reportElement x="0" y="0" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Bill Number:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="0" width="200" height="20"/>
                <textFieldExpression><![CDATA[$P{BILL_NUMBER}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="25" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Patient Name:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="25" width="200" height="20"/>
                <textFieldExpression><![CDATA[$P{PATIENT_NAME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="50" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Dentist:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="50" width="200" height="20"/>
                <textFieldExpression><![CDATA[$P{DENTIST_NAME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="75" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Treatment:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="75" width="200" height="20"/>
                <textFieldExpression><![CDATA[$P{TREATMENT_NAME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="100" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="100" width="200" height="20"/>
                <textFieldExpression><![CDATA[$P{BILL_DATE}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="120">
            <staticText>
                <reportElement x="300" y="0" width="130" height="25"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Consultation Fee:]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="0" width="125" height="25"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Rs. " + $P{CONSULTATION_FEE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="300" y="25" width="130" height="25"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Treatment Fee:]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="25" width="125" height="25"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Rs. " + $P{TREATMENT_FEE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="300" y="55" width="130" height="25"/>
                <textElement textAlignment="Right"><font isBold="true" size="12"/></textElement>
                <text><![CDATA[Total:]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="55" width="125" height="25"/>
                <textElement textAlignment="Right"><font isBold="true" size="12"/></textElement>
                <textFieldExpression><![CDATA["Rs. " + $P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="300" y="80" width="130" height="25"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Amount Paid:]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="80" width="125" height="25"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Rs. " + $P{AMOUNT_PAID}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="300" y="105" width="130" height="25"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Balance Due:]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="105" width="125" height="25"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs. " + $P{BALANCE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <pageFooter>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Thank you for choosing Sunrise Dental!]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>
