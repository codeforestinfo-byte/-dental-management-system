          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/appointments",
            "header": [
              { "key": "Authorization", "value": "Bearer {{receptionistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
