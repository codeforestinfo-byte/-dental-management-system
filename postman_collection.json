{
  "info": {
    "name": "DentaFlow API - Complete Test Collection",
    "description": "All 10 services with test endpoints for Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "receptionistToken", "value": "" },
    { "key": "dentistToken", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "dentistId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "treatmentId", "value": "" },
    { "key": "billId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication Service",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has JWT token', () => {",
                  "  const res = pm.response.json();",
                  "  pm.environment.set('adminToken', res.accessToken || res.token);",
                  "  pm.expect(res.accessToken || res.token).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Receptionist",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"receptionist\",\n  \"password\": \"receptionist123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has JWT token', () => {",
                  "  const res = pm.response.json();",
                  "  pm.environment.set('receptionistToken', res.accessToken || res.token);",
                  "  pm.expect(res.accessToken || res.token).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Dentist",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dentist\",\n  \"password\": \"dentist123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has JWT token', () => {",
                  "  const res = pm.response.json();",
                  "  pm.environment.set('dentistToken', res.accessToken || res.token);",
                  "  pm.expect(res.accessToken || res.token).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User - /me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/change-password",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"admin123\",\n  \"newPassword\": \"newadmin123\"\n}"
            }
          }
        },
        {
          "name": "Register New User (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"newuser123\",\n  \"email\": \"newuser@dental.com\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\",\n  \"role\": \"RECEPTIONIST\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "2. Patient Service",
      "item": [
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/patients",
            "header": [
              { "key": "Authorization", "value": "Bearer {{receptionistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"MALE\",\n  \"phone\": \"0771234567\",\n  \"email\": \"john.doe@email.com\",\n  \"address\": \"123 Main Street, Colombo\",\n  \"nic\": \"901234567V\",\n  \"emergencyContact\": \"0779876543\",\n  \"bloodGroup\": \"O+\",\n  \"allergies\": \"None\",\n  \"medicalHistory\": \"No prior conditions\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has patient ID', () => {",
                  "  const res = pm.response.json();",
                  "  const id = res.id || res.data?.id;",
                  "  pm.environment.set('patientId', id);",
                  "  pm.expect(id).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Patients (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/patients?page=0&size=10&sort=firstName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "firstName,asc" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{receptionistToken}}" }]
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/patients/{{patientId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{receptionistToken}}" }]
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Search Patients",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/patients/search?q=John&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "search"],
              "query": [
                { "key": "q", "value": "John" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{receptionistToken}}" }]
          }
        },
        {
          "name": "Get Patient by Barcode",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/patients/barcode?number=PAT-00001",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "barcode"],
              "query": [{ "key": "number", "value": "PAT-00001" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{receptionistToken}}" }]
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/patients/{{patientId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{receptionistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe Updated\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"MALE\",\n  \"phone\": \"0771234568\",\n  \"email\": \"john.doe.updated@email.com\",\n  \"address\": \"456 New Street, Colombo\",\n  \"nic\": \"901234567V\",\n  \"emergencyContact\": \"0779876543\"\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/patients/{{patientId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{receptionistToken}}" }]
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200 or 204', () => pm.response.to.have.status([200, 204]));"] } }
          ]
        }
      ]
    },
    {
